/* ============ 全局 ============ */
QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #2c3e50;
}
QMainWindow, QDialog {
    background: #f0f2f5;
}

/* ============ 左侧导航 ============ */
QListWidget#sideMenu {
    background: #1f2d3d;
    border: none;
    outline: none;
    font-size: 14px;
}
QListWidget#sideMenu::item {
    height: 42px;
    padding-left: 18px;
    color: #c0c8d0;
    border-left: 3px solid transparent;
}
QListWidget#sideMenu::item:hover {
    background: #2b3e54;
    color: #ffffff;
}
QListWidget#sideMenu::item:selected {
    background: #2c6bbf;
    border-left: 3px solid #4fc3f7;
    color: #ffffff;
    font-weight: bold;
}

/* ============ 顶部工具栏 ============ */
QToolBar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e4e7ed;
    padding: 6px 14px;
    spacing: 12px;
}
QToolBar QLabel {
    color: #34495e;
}

/* ============ 表格 ============ */
QTableWidget, QTableView {
    background: #ffffff;
    alternate-background-color: #f7f9fc;
    selection-background-color: #d9ecff;
    selection-color: #1a5fb4;
    gridline-color: #eef0f3;
    border: 1px solid #e4e7ed;
    border-radius: 6px;
}
QHeaderView::section {
    background: #eef3f9;
    color: #34495e;
    padding: 8px 6px;
    border: none;
    border-bottom: 2px solid #cddced;
    font-weight: bold;
}
QTableWidget::item {
    padding: 5px 6px;
    border-bottom: 1px solid #f0f2f5;
}
QTableWidget::item:hover {
    background: #f0f7ff;
}
QTableWidget::item:selected {
    background: #d9ecff;
}

/* ============ 按钮 ============ */
QPushButton {
    background: #409eff;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 7px 16px;
    min-height: 18px;
}
QPushButton:hover {
    background: #66b1ff;
}
QPushButton:pressed {
    background: #337ecc;
}
QPushButton:disabled {
    background: #c0c4cc;
    color: #eeeeee;
}
QPushButton#dangerBtn { background: #f56c6c; }
QPushButton#dangerBtn:hover { background: #f78989; }
QPushButton#secondaryBtn {
    background: #ffffff;
    color: #409eff;
    border: 1px solid #d9e6f5;
}
QPushButton#secondaryBtn:hover { background: #ecf5ff; }

/* ============ 输入控件 ============ */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #dcdfe6;
    border-radius: 5px;
    padding: 6px 10px;
    min-height: 18px;
    selection-background-color: #409eff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border-color: #409eff;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    border: 1px solid #dcdfe6;
    selection-background-color: #ecf5ff;
    selection-color: #409eff;
}
QCheckBox, QRadioButton {
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator:checked {
    background: #409eff;
    border: 1px solid #409eff;
    border-radius: 3px;
}

/* ============ 分组框 ============ */
QGroupBox {
    background: #ffffff;
    border: 1px solid #e4e7ed;
    border-radius: 8px;
    margin-top: 14px;
    padding: 18px 14px 14px 14px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #2c6bbf;
}

/* ============ 标签 ============ */
QLabel {
    color: #34495e;
}

/* ============ 滚动条 ============ */
QScrollBar:vertical {
    background: #f0f2f5;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c8d0da;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #a8b4c2;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #f0f2f5;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #c8d0da;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
